# 로컬 개발 전용 예시. 실제 비밀값을 넣지 않는다.
# Compose 프로젝트 이름을 운영과 분리한다. 아직 Compose 파일은 없다.
COMPOSE_PROJECT_NAME=picksy-dev

# 아래 PICKSY_DEV_*는 후속 로컬 구성에서 사용할 예약 변수다.
# 현재 앱이나 Compose가 읽는 설정이 아니며 실제 연결은 구현 단계에서 검증한다.
# 공개 진입점도 로컬 개발에서는 loopback에만 바인딩한다.
PICKSY_DEV_BIND_ADDRESS=127.0.0.1
PICKSY_DEV_HTTP_PORT=18080
# 직접 Gateway를 실행하는 개발 모드 전용. 컨테이너 풀의 개별 포트로 쓰지 않는다.
PICKSY_DEV_GATEWAY_PORT=18081
# 호스트에서 직접 실행할 때만 사용한다. 컨테이너 DB 경로와 혼용하지 않는다.
PICKSY_DEV_DATA_DIR=.local/picksy-dev
