{
	# 관리 API는 controller만 참여한 전용 네트워크의 IP에만 연다.
	admin {$STAGE2_ADMIN_IP}:2019
	persist_config off
	auto_https disable_redirects
	skip_install_trust
	# 접근 로그는 켜지 않는다. 오류도 인증 헤더·요청 URI를 남기지 않는다.
	log default {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>uri delete
			}
		}
	}
}

# 사용자 인증이 아니라 제어면 생존 확인이다. 원본 키·본문·URI는 이 요청에 전달하지 않는다.
(permit) {
	forward_auth {$STAGE2_CONTROLLER_IP}:9092 {
		uri /permit
		header_up -*
		header_up -Authorization
		header_up -Cookie
		# forward_auth가 자동 추가하는 원본 URI/메서드도 set 이후 지운다.
		header_up -X-Forwarded-*
		header_up Host {$STAGE2_CONTROLLER_IP}:9092
		lb_retries 0
		transport http {
			dial_timeout 500ms
			response_header_timeout 500ms
			keepalive off
		}
	}
}

https://localhost, https://127.0.0.1 {
	tls internal
	import permit
	# controller는 이 완전한 handler만 교체한다. 최초 상태와 빈 풀은 명시적으로 실패한다.
	respond "gateway_unavailable" 503
}

http://:18081 {
	# 공개 ingress·추론·관리 인터페이스에는 내부 추론 리스너를 열지 않는다.
	bind {$STAGE2_PRIVATE_IP}
	respond "inference_unavailable" 503
}
